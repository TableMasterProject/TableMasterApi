    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "ConfigPerso": {
    "SecretKey": "",
    "Issuer": "TableMasterApi",
    "Audience": "TableMasterApi",
    "KeyApiGoogleMaps": "",
