NAME_ENV=dev
DB_PORT=5432
DB_NAME=TableMaster
DB_USER=postgres
DB_PASSWORD=change-me

API_PORT=8080
JWT_SECRET=replace-with-at-least-32-bytes
JWT_ISSUER=TableMasterApi
JWT_AUDIENCE=TableMasterApi
CORS_ALLOWED_ORIGIN=https://app.example.com

GOOGLE_MAPS_API_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=tablemaster-firebase.json

BREVO_ENABLED=false
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=TableMaster
APP_LINKS_BASE_URL=https://app.example.com

SENTRY_DSN=
SENTRY_DEBUG=false
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_SEND_DEFAULT_PII=false

RUN_MIGRATIONS_ON_STARTUP=true
ENABLE_SWAGGER=false
